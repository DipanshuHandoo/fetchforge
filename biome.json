{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "examples/**",
      "*.json",
      "!dist",
      "!coverage",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": { "noExplicitAny": "error", "noConfusingVoidType": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  }
}
