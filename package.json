{
  "name": "@dipanshuhandoo/fetchforge",
  "version": "1.1.0",
  "description": "Resilient fetch client for Node.js and browsers: retries, timeouts, circuit breaker, response cache with stale-while-revalidate and pluggable stores (memory, Redis, IndexedDB, localStorage, files), auth token refresh, rate limiting, idempotency keys, schema validation, progress, streaming, offline queue, mocking, hooks, plugins and metrics.",
  "license": "MIT",
  "author": "Dipanshu Handoo",
  "keywords": [
    "fetch",
    "http",
    "http-client",
    "retry",
    "backoff",
    "timeout",
    "circuit-breaker",
    "deduplication",
    "hedging",
    "middleware",
    "hooks",
    "bulk",
    "cache",
    "stale-while-revalidate",
    "redis",
    "indexeddb",
    "rate-limit",
    "idempotency",
    "token-refresh",
    "offline",
    "sse",
    "ndjson",
    "mock",
    "typescript"
  ],
  "homepage": "https://github.com/DipanshuHandoo/fetchforge#readme",
  "bugs": {
    "url": "https://github.com/DipanshuHandoo/fetchforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DipanshuHandoo/fetchforge.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./min": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.min.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.min.js"
      }
    },
    "./browser": "./dist/browser/fetchforge.global.min.js",
    "./stores": {
      "import": {
        "types": "./dist/esm/stores.d.ts",
        "default": "./dist/esm/stores.js"
      },
      "require": {
        "types": "./dist/cjs/stores.d.ts",
        "default": "./dist/cjs/stores.js"
      }
    },
    "./stores/file": {
      "import": {
        "types": "./dist/esm/file-store.d.ts",
        "default": "./dist/esm/file-store.js"
      },
      "require": {
        "types": "./dist/cjs/file-store.d.ts",
        "default": "./dist/cjs/file-store.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/browser/fetchforge.global.min.js",
  "jsdelivr": "./dist/browser/fetchforge.global.min.js",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:package": "node scripts/check-package.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "verify": "node scripts/verify.mjs",
    "pack:check": "node scripts/check-package.mjs --list",
    "publish:dry": "npm publish --dry-run --access public --registry https://registry.npmjs.org/",
    "release": "node scripts/release.mjs",
    "publish:public": "npm publish --access public --registry https://registry.npmjs.org/",
    "prepublishOnly": "node scripts/verify.mjs --skip-browser"
  },
  "dependencies": {
    "@dipanshuhandoo/async-slot-pool": "^1.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  }
}
